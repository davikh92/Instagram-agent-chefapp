# Cloudinary — hospedagem temporária dos vídeos
# Crie conta grátis em cloudinary.com
CLOUDINARY_CLOUD_NAME=seu-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=seu-api-secret

# Instagram Graph API
# Siga o guia em docs/setup-instagram-api.md
INSTAGRAM_ACCESS_TOKEN=EAABsbCS...token-longa-duracao
INSTAGRAM_USER_ID=17841400000000

# Pinterest API v5
# Siga o guia em docs/setup-pinterest.md
PINTEREST_APP_ID=1234567
PINTEREST_APP_SECRET=seu-app-secret
PINTEREST_REFRESH_TOKEN=pina-...gerado-por-scripts-pinterest-oauth-js
