node_modules/
templates/generated/*.html
*.log
.env

# Binários de vídeo — armazenados no Cloudinary, não no repositório
# (reels.mp4 podem ter 10-100 MB cada)
ready-to-post/**/*.mp4
ready-to-post/**/*.webm

# Lock files de publicação — nunca commitados
ready-to-post/**/.publishing

# Marcador de falha de publicação — efêmero, lido pelo workflow no mesmo run
.publish-failed

# Saída de testes de modelo — descartável, fica no Cloudinary
tests/

# Arquivos de trabalho da quinzena (regeneráveis)
data/briefing-*.json
data/plano-*.json
data/queue.json

# Gerados localmente — não precisam de versionamento

# Logs de execução (gerados em runtime — não commitados para evitar conflitos)
logs/

# Configurações locais do Claude Code
.claude/
